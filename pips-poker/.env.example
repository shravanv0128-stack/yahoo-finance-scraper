# Public Supabase config (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix with NEXT_PUBLIC_. Used only inside app/api/** route handlers
# via src/lib/supabaseServer.ts to perform privileged game-mutating operations
# (dealing cards, evaluating showdown, updating chip stacks) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
